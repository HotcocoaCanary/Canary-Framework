# --- Python 字节码 / bytecode & caches ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- 打包产物 / packaging & build artifacts ---
build/
dist/
*.egg-info/
*.egg

# --- 测试与覆盖率 / tests & coverage ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- 类型检查与 lint 缓存 / type-check & lint caches ---
.mypy_cache/
.ruff_cache/

# --- 虚拟环境 / virtual environments ---
.venv/
venv/
env/
.env
.envrc

# --- 编辑器 / editors & IDEs ---
.idea/
.vscode/
*.swp

# --- 文档构建产物 / docs build output ---
site/

# --- 锁文件：库项目不入库，CI 每次按 pyproject.toml 现解析依赖 ---
# Lock file: not committed for libraries; CI resolves fresh from pyproject.toml.
uv.lock

# --- 操作系统 / OS ---
.DS_Store
Thumbs.db
